# php-backend/.htaccess
# Hostinger hPanel & Apache Rewrite Rules for Food Court Multi-Tier Architecture

RewriteEngine On

# 0. Canonicalize directory URLs (/admin -> /admin/, /vendor -> /vendor/)
RewriteRule ^admin$ admin/ [R=301,L]
RewriteRule ^vendor$ vendor/ [R=301,L]
RewriteRule ^super$ admin/ [R=301,L]

# 1. API routes -> api/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# 2. Super Admin Clean URLs (/admin -> admin/index.php)
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/login/?$ admin/login.php [L]
RewriteRule ^admin/logout/?$ admin/logout.php [L]

# 3. Sub-Admin / Vendor Clean URLs (/vendor -> vendor/index.php)
RewriteRule ^vendor/?$ vendor/index.php [L]
RewriteRule ^vendor/login/?$ vendor/login.php [L]
RewriteRule ^vendor/logout/?$ vendor/logout.php [L]

# 4. Backward Compatibility: /super redirects to /admin
RewriteRule ^super(/.*)?$ /admin$1 [R=301,L]

# 5. Root redirect to /admin
RewriteRule ^$ admin/index.php [R=302,L]

# 6. Security: Prevent access to SQLite file, backups and sensitive files
<FilesMatch "\.(sqlite|sqlite3|db|env|json|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 7. Enable CORS for mobile app & external calls
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
